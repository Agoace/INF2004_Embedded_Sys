classDef note fill:#fff,stroke:#999,stroke-width:2px,stroke-dasharray:6 5,color:#111,font-size:34px;
classDef legend fill:#f7f7f7,stroke:#777,stroke-width:1px,color:#111,font-size:34px;

class MOTION taskMotion;
class LINE task;
class SCAN taskScan;
class CTRL taskCtrl;
class IMU taskImu;
class TELEM taskTelem;
class ENC_HW,ESTOP_HW,IR_HW,ECHO_HW,SCAN_HW,IMU_HW,MOTOR_HW,WIFI_HW hardware;
class ENC_ISR,ESTOP_ISR,ECHO_ISR isr;
class COUNTS,SNAP,LEG_DATA shared;
class MOTION_MBF,CTRL_MBF,LEG_MBF buffer;
class MODE,LEG_FLAG flag;
class ESTOP_SEM,ECHO_SEM,LEG_SEM shared;
class EVENTS note;
class LEGEND,LEG_TASK,LEG_HW,LEG_ISR,LEG_COLORS legend;

