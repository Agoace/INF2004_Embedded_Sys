classDef taskCtrl fill:#fff0b2,stroke:#333,stroke-width:2px,color:#111,font-size:40px;
classDef taskScan fill:#ffd2d2,stroke:#333,stroke-width:2px,color:#111,font-size:40px;
classDef taskImu fill:#e4d7f5,stroke:#333,stroke-width:2px,color:#111,font-size:40px;
classDef taskTelem fill:#d6e8ff,stroke:#333,stroke-width:2px,color:#111,font-size:40px;
classDef hardware fill:#e6e6e6,stroke:#333,stroke-width:2px,color:#111,font-size:40px;
classDef isr fill:#eadcff,stroke:#333,stroke-width:2px,color:#111,font-size:40px;
classDef shared fill:#fff4b2,stroke:#333,stroke-width:2px,color:#111,font-size:40px;
classDef buffer fill:#cfe2ff,stroke:#333,stroke-width:2px,color:#111,font-size:40px;
