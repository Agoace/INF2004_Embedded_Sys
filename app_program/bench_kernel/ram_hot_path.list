# BENCH_KERNEL_RAM=1 (UP diagnostic only): sections moved from flash (XIP) to
# executable RAM. Format: object section [symbols]. With no symbols, the
# symbol is the section name after ".text.". The build renames each section
# to .data.ramfunc.<name>; the unchanged template linker script copies
# .data.* to RAM. ram_proof.py fails the build if a symbol stays in flash.
# Left in flash on purpose: rt_call/rt_max (P1 measurement, same in both
# images), memset (C library), the generator body (drift control; it
# still calls drv_time_us, which is in RAM).
# Kernel: dispatcher (PendSV), interrupt entry, timer, critical sections.
kernel/sysdepend/cpu/core/armv6m/dispatch.o .text knl_dispatch_entry
kernel/sysdepend/cpu/core/armv6m/cpu_cntl.o .text.knl_dispatch
kernel/sysdepend/cpu/core/armv6m/interrupt.o .text.knl_hll_inthdr
kernel/sysdepend/cpu/core/armv6m/interrupt.o .text.knl_systim_inthdr
lib/libtk/sysdepend/cpu/core/armv6m/int_armv6m.o .text.disint
kernel/tkernel/timer.o .text.knl_timer_handler
kernel/tkernel/timer.o .text.knl_timer_insert
kernel/tkernel/timer.o .text.knl_enqueue_tmeb
kernel/tkernel/timer.o .text.knl_timer_insert_reltim
lib/libtk/sysdepend/cpu/rp2040/int_rp2040.o .text.ClearInt
# Kernel calls measured by P1 [kcall], with their wait/ready helpers.
kernel/tkernel/task_sync.o .text.tk_wup_tsk
kernel/tkernel/task_sync.o .text.tk_slp_tsk
kernel/tkernel/task_sync.o .text.tk_can_wup
kernel/tkernel/mutex.o .text.tk_loc_mtx
kernel/tkernel/mutex.o .text.tk_unl_mtx
kernel/tkernel/mutex.o .text.knl_release_mutex
kernel/tkernel/mutex.o .text.knl_signal_all_mutex
kernel/tkernel/mutex.o .text.mtx_chg_pri
kernel/tkernel/mutex.o .text.mtx_rel_wai
kernel/tkernel/task.o .text.knl_make_ready
kernel/tkernel/task.o .text.knl_make_non_ready
kernel/tkernel/task.o .text.knl_change_task_priority
kernel/tkernel/wait.o .text.knl_make_wait
kernel/tkernel/wait.o .text.knl_make_wait_reltim
kernel/tkernel/wait.o .text.knl_wait_release_ok
kernel/tkernel/wait.o .text.knl_wait_release_tmout
kernel/tkernel/wait.o .text.knl_wait_delete
kernel/tkernel/wait.o .text.knl_gcb_make_wait
kernel/tkernel/wait.o .text.knl_gcb_change_priority
kernel/tkernel/wait.o .text.knl_gcb_top_of_wait_queue
# Line and encoder ISRs with their hardware (bench provider) helpers.
app_program/subsystem3/drv_line.o .text.alarm_irq
app_program/platform/drv_gpio_irq.o .text.gpio_dispatch
app_program/subsystem2/motion.o .text.encoder_irq
app_program/bench_kernel/bench_inputs_hw.o .text.drv_line_hw_alarm
app_program/bench_kernel/bench_timer_hw.o .text.bk_line_timer_alarm
app_program/bench_kernel/bench_timer_hw.o .text.bk_line_timer_ack
app_program/bench_kernel/bench_motor_hw.o .text.drv_motor_hw_ab
app_program/bench_kernel/bench_inputs_hw.o .text.drv_line_hw_ack
app_program/bench_kernel/bench_inputs_hw.o .text.drv_line_hw_read
app_program/bench_kernel/bench_gpio_hw.o .text.drv_gpio_irq_hw_ack
app_program/bench_kernel/bench_gpio_hw.o .text.drv_gpio_irq_hw_pending
app_program/bench_kernel/bench_gpio.o .text.bk_gpio_ack
app_program/bench_kernel/bench_gpio.o .text.bk_gpio_pending
