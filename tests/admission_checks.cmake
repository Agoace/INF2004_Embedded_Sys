# M3: use the existing fully configured real-source fixture lists.
get_target_property(busy_sources test_telemetry SOURCES)
list(REMOVE_ITEM busy_sources "${REPO}/tests/test_telemetry.c")
get_target_property(dump_start_sources test_vehicle_network_task SOURCES)
list(REMOVE_ITEM dump_start_sources "${REPO}/tests/test_vehicle_network_task.c")
list(APPEND dump_start_sources ${busy_sources})
list(REMOVE_DUPLICATES dump_start_sources)
foreach(placement up split control)
    set(smp 1)
    set(force 0)
    if(placement STREQUAL "up")
        set(smp 0)
    elseif(placement STREQUAL "control")
        set(force 1)
    endif()
    set(busy_target "test_telemetry_busy_${placement}")
    add_executable(${busy_target} test_telemetry_busy.c ${busy_sources})
    set(vehicle_target "test_vehicle_dump_start_${placement}")
    add_executable(${vehicle_target} test_vehicle_dump_start.c
        ${dump_start_sources})
    foreach(target ${busy_target} ${vehicle_target})
        target_include_directories(${target} BEFORE PRIVATE
            "${REPO}/tests/mtk_stubs")
        target_compile_definitions(${target} PRIVATE TK_SUPPORT_SMP=${smp}
            TK_MAX_CORE=2 APP_FORCE_CORE0=${force})
        target_link_libraries(${target} PRIVATE m)
    endforeach()
    target_compile_definitions(${vehicle_target} PRIVATE TM_MQTT=1)
    foreach(kind 0 1 2 3 5)
        add_test(NAME "${busy_target}_${kind}" COMMAND ${busy_target} ${kind})
    endforeach()
    add_test(NAME ${vehicle_target} COMMAND ${vehicle_target})
    add_test(NAME "${vehicle_target}_calibrate"
        COMMAND ${vehicle_target} calibrate)
endforeach()
